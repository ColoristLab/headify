{
  "name": "headify",
  "version": "0.4.0",
  "description": "File header banner generator for Node.js.",
  "keywords": [
    "banner",
    "head",
    "header"
  ],
  "bugs": {
    "url": "https://github.com/ColoristLab/headify/issues"
  },
  "license": "MIT",
  "author": "ajiho",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ColoristLab/headify.git"
  },
  "funding": "https://www.lujiahao.com/sponsor",
  "bin": {
    "headify": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "tag": "latest"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "pnpm run lint --fix",
    "size": "size-limit",
    "clean": "rimraf dist",
    "tsdown": "tsdown",
    "build": "run-s clean tsdown size",
    "dev": "pnpm run tsdown --watch",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "typecheck": "tsc --noEmit",
    "test": "vitest --coverage",
    "test:ui": "pnpm run test --ui",
    "coverage": "vitest run --coverage",
    "publint": "publint",
    "commitlint": "commitlint -e -V",
    "check": "run-s fmt:check lint typecheck coverage build publint",
    "release": "releaseasy"
  },
  "dependencies": {
    "cac": "^7.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "npm-run-all2": "^9.0.4",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "pkg-types": "^2.4.0",
    "publint": "^0.3.25",
    "releaseasy": "^0.1.1",
    "rimraf": "^6.1.4",
    "simple-git-hooks": "^2.14.0",
    "size-limit": "^14.3.0",
    "ts-dedent": "^2.3.0",
    "tsdown": "^0.23.7",
    "typescript": "6.0.3",
    "vitepress": "2.0.0-alpha.21",
    "vitepress-plugin-group-icons": "^1.8.1",
    "vitest": "^5.1.0"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm commitlint",
    "pre-commit": "pnpm check"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^22.18.0 || ^24.18.0 || >=26.3.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
